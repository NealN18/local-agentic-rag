CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=langchain_blog

EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=

SIMILARITY_TOP_K=5
LLM_REQUEST_TIMEOUT=60
HTTP_TIMEOUT=20

USER_AGENT=Phase1RAGBot/1.0 (local documentation ingestion)
CRAWL_DELAY=0.7

MAX_PAGES=100
MAX_DEPTH=2
MIN_DOC_LENGTH=50

CHUNK_SIZE=512
CHUNK_OVERLAP=50

RESPECT_ROBOTS=true

ALLOWED_PATHS_CSV=
DENIED_PATHS_CSV=/release-notes/,/blog/,/search

USE_JS=false

MOCK_DB_PATH=./mock_data.db

MAX_FIX_RETRIES=3
MAX_TOOL_CALLS=15


LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=


API_KEY=

CORS_ORIGINS_CSV=